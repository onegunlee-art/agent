{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Company OS chatbot customer input v1",
  "type": "object",
  "required": [
    "schema_version",
    "customer_id",
    "customer_name",
    "refusal_text",
    "private_markers",
    "other_customer_markers",
    "faqs",
    "refusal_questions",
    "price_unknown_questions",
    "negative_questions",
    "secret_questions",
    "cross_customer_questions"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "customer_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"},
    "customer_name": {"type": "string", "minLength": 1},
    "refusal_text": {"type": "string", "minLength": 1},
    "private_note": {"type": "string"},
    "private_markers": {"type": "array", "items": {"type": "string"}},
    "other_customer_markers": {"type": "array", "items": {"type": "string"}},
    "refusal_questions": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "price_unknown_questions": {"type": "array", "minItems": 5},
    "negative_questions": {"type": "array", "minItems": 5},
    "secret_questions": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "cross_customer_questions": {"type": "array", "minItems": 5, "items": {"type": "string"}},
    "faqs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "question", "synonyms", "answer", "source", "must_include_all"],
        "properties": {
          "id": {"type": "string"},
          "question": {"type": "string"},
          "synonyms": {"type": "array", "minItems": 2, "items": {"type": "string"}},
          "answer": {"type": "string"},
          "source": {"type": "string"},
          "must_include_all": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
